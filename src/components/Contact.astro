---
import MapPin from "@lucide/astro/icons/map-pin";
import MessageCircle from "@lucide/astro/icons/message-circle";
import Clock from "@lucide/astro/icons/clock";
---

<section id="contacto" class="bg-black py-20 text-white md:py-28">
    <div class="mx-auto w-full max-w-7xl px-6">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div>
                <header class="max-w-xl">
                    <span
                        class="border-l-4 border-red-600 pl-3 text-sm font-bold uppercase tracking-[0.2em] text-red-500"
                        >Contacto</span
                    >

                    <h2
                        class="mt-6 text-4xl font-black uppercase leading-tight tracking-tight md:text-5xl"
                    >
                        Da el primer paso hacia tus objetivos
                    </h2>

                    <p class="mt-6 text-lg leading-relaxed text-gray-400">
                        Escríbenos para conocer nuestros planes, resolver tus
                        dudas o agendar una clase de prueba.
                    </p>
                </header>

                <address class="mt-10 grid gap-6 not-italic sm:grid-cols-2">
                    <div class="flex gap-4 border-l-2 border-zinc-800 pl-4">
                        <MapPin
                            class="mt-1 size-6 shrink-0 text-red-500"
                            stroke-width={2}
                            aria-hidden="true"
                        />

                        <div>
                            <h3
                                class="font-bold uppercase tracking-wide text-white"
                            >
                                Ubicación
                            </h3>

                            <p class="mt-2 leading-relaxed text-gray-400">
                                Temuco, Chile
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 border-l-2 border-zinc-800 pl-4">
                        <MessageCircle
                            class="mt-1 size-6 shrink-0 text-red-500"
                            stroke-width={2}
                            aria-hidden="true"
                        />

                        <div>
                            <h3
                                class="font-bold uppercase tracking-wide text-white"
                            >
                                WhatsApp
                            </h3>

                            <a
                                href="#"
                                class="mt-2 inline-block text-gray-400 transition hover:text-red-500"
                            >
                                Número por confirmar
                            </a>
                        </div>
                    </div>

                    <div class="flex gap-4 border-l-2 border-zinc-800 pl-4">
                        <span class="instagram-icon mt-1" aria-hidden="true"
                        ></span>

                        <div>
                            <h3
                                class="font-bold uppercase tracking-wide text-white"
                            >
                                Instagram
                            </h3>

                            <a
                                href="#"
                                class="mt-2 inline-block text-gray-400 transition hover:text-red-500"
                            >
                                Perfil por confirmar
                            </a>
                        </div>
                    </div>

                    <div class="flex gap-4 border-l-2 border-zinc-800 pl-4">
                        <Clock
                            class="mt-1 size-6 shrink-0 text-red-500"
                            stroke-width={2}
                            aria-hidden="true"
                        />
                        <div>
                            <h3
                                class="font-bold uppercase tracking-wide text-white"
                            >
                                Horario
                            </h3>
                            <p class="mt-2 leading-relaxed text-gray-400">
                                Horario por confirmar
                            </p>
                        </div>
                    </div>
                </address>
            </div>

            <form
                action="https://formspree.io/f/ID_DEL_FORMULARIO"
                method="POST"
                aria-label="Formulario de contacto"
                class="relative overflow-hidden rounded-sm border border-zinc-800 bg-zinc-950 p-6 md:p-8"
            >
                <input
                    type="hidden"
                    name="_subject"
                    value="Nueva consulta desde Weider Gym"
                />

                <input
                    type="hidden"
                    name="origen"
                    value="Landing page Weider Gym"
                />
                <div
                    class="absolute left-0 top-0 h-1 w-full bg-red-600"
                    aria-hidden="true"
                >
                </div>

                <div class="space-y-6">
                    <div class="grid gap-6 sm:grid-cols-2">
                        <div>
                            <label
                                for="nombre"
                                class="mb-2 block text-sm font-bold uppercase tracking-wide text-gray-300"
                            >
                                Nombre
                            </label>

                            <input
                                id="nombre"
                                name="nombre"
                                type="text"
                                autocomplete="name"
                                required
                                placeholder="Tu nombre"
                                class="w-full rounded-sm border border-zinc-700 bg-black px-4 py-3 text-white outline-none transition placeholder:text-gray-600 focus:border-red-600 focus:ring-2 focus:ring-red-600/20"
                            />
                        </div>

                        <div>
                            <label
                                for="telefono"
                                class="mb-2 block text-sm font-bold uppercase tracking-wide text-gray-300"
                            >
                                Teléfono
                            </label>

                            <input
                                id="telefono"
                                name="telefono"
                                type="tel"
                                autocomplete="tel"
                                required
                                placeholder="+56 9 1234 5678"
                                class="w-full rounded-sm border border-zinc-700 bg-black px-4 py-3 text-white outline-none transition placeholder:text-gray-600 focus:border-red-600 focus:ring-2 focus:ring-red-600/20"
                            />
                        </div>
                    </div>

                    <div>
                        <label
                            for="email"
                            class="mb-2 block text-sm font-bold uppercase tracking-wide text-gray-300"
                        >
                            Correo electrónico
                        </label>

                        <input
                            id="email"
                            name="email"
                            type="email"
                            autocomplete="email"
                            required
                            placeholder="correo@ejemplo.cl"
                            class="w-full rounded-sm border border-zinc-700 bg-black px-4 py-3 text-white outline-none transition placeholder:text-gray-600 focus:border-red-600 focus:ring-2 focus:ring-red-600/20"
                        />
                    </div>

                    <div>
                        <label
                            for="mensaje"
                            class="mb-2 block text-sm font-bold uppercase tracking-wide text-gray-300"
                        >
                            Mensaje
                        </label>

                        <textarea
                            id="mensaje"
                            name="mensaje"
                            rows="5"
                            required
                            placeholder="Cuéntanos qué objetivo quieres alcanzar"
                            class="w-full resize-y rounded-sm border border-zinc-700 bg-black px-4 py-3 text-white outline-none transition placeholder:text-gray-600 focus:border-red-600 focus:ring-2 focus:ring-red-600/20"
                        ></textarea>
                    </div>
                </div>

                <button
                    type="submit"
                    class="mt-8 w-full rounded-sm bg-red-600 px-6 py-3 font-bold uppercase tracking-wide text-white transition duration-300 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-zinc-950"
                >
                    Enviar consulta
                </button>
            </form>
        </div>

        <!-- Ubicación provisional: reemplazar por la dirección real de Weider Gym -->
        <!-- Ubicación provisional: reemplazar por la dirección real de Weider Gym -->
        <div
            class="mx-auto mt-20 grid max-w-5xl overflow-hidden rounded-sm border border-zinc-800 bg-zinc-950 lg:mt-26 lg:grid-cols-[1.1fr_0.9fr]"
        >
            <div class="flex flex-col justify-center p-6 md:p-8">
                <p
                    class="text-sm font-bold uppercase tracking-[0.2em] text-red-500"
                >
                    Encuéntranos
                </p>

                <h3 class="mt-3 text-3xl font-black uppercase text-white">
                    Weider Gym en Temuco
                </h3>

                <p class="mt-4 max-w-md leading-relaxed text-gray-400">
                    Consulta nuestra ubicación y abre la ruta directamente en
                    Google Maps.
                </p>

                <a
                    href="https://share.google/85mbCPsLeaTH4NTUL"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-6 inline-block self-start rounded-sm border-2 border-red-600 px-5 py-3 text-center text-sm font-bold uppercase tracking-wide text-white transition hover:bg-red-600"
                >
                    Cómo llegar
                </a>
            </div>

            <div class="h-72 sm:h-80 lg:h-88">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3112.3219883633797!2d-72.6109058!3d-38.7333728!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x96623f0f6ecffc81%3A0xa0819486bef36f8d!2sPortal%20Temuco!5e0!3m2!1ses!2scl!4v1785797017339!5m2!1ses!2scl"
                    title="Ubicación provisional de Weider Gym en Temuco"
                    class="h-full w-full border-0 grayscale-20 brightness-75 contrast-125"
                    loading="lazy"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
        </div>
    </div>
</section>

<style>
    .instagram-icon {
        display: inline-block;
        width: 1.5rem;
        height: 1.5rem;
        flex-shrink: 0;
        background-color: #ef4444;

        mask: url("/images/social/instagram-logo.svg") center / contain
            no-repeat;
        -webkit-mask: url("/images/social/instagram-logo.svg") center / contain
            no-repeat;
    }
</style>
