---
const footerLinks = [
    {
        href: "#nosotros",
        label: "Nosotros",
    },
    {
        href: "#servicios",
        label: "Servicios",
    },
    {
        href: "#planes",
        label: "Planes",
    },
    {
        href: "#contacto",
        label: "Contacto",
    },
];
---

<footer class="border-t border-zinc-800 bg-zinc-950 text-white">
    <div
        class="mx-auto grid w-full max-w-7xl gap-10 px-6 py-14 md:grid-cols-2 lg:grid-cols-3"
    >
        <!-- Marca y redes -->
        <div>
            <a
                href="#inicio"
                class="flex items-center gap-0"
                aria-label="Ir al inicio de Weider Gym"
            >
                <img
                    src="/images/logo/weider-icon.svg"
                    alt=""
                    class="h-12 w-8 shrink-0 object-contain sm:h-14 sm:w-10"
                    aria-hidden="true"
                />

                <div
                    class="-translate-y-0.5 flex flex-col items-start leading-none"
                >
                    <span
                        class="origin-left scale-x-[1.06] text-[1.75rem] font-black uppercase tracking-[0.01em] text-white sm:text-[2.05rem]"
                    >
                        Weider
                    </span>

                    <span
                        class="mt-1 whitespace-nowrap text-[5.5px] font-bold uppercase tracking-[0.08em] sm:text-[6.6px] sm:tracking-[0.09em]"
                    >
                        <span class="text-red-600">Gym Club</span>

                        <span class="mx-1 text-gray-500">|</span>

                        <span class="text-gray-300">
                            Bodybuilding &amp; Fitness
                        </span>
                    </span>
                </div>
            </a>

            <p class="mt-2 text-sm font-bold uppercase tracking-[0.15em]">
                <span class="text-white">Entrena.</span>
                <span class="text-red-500"> Avanza.</span>
                <span class="text-white"> Transforma.</span>
            </p>

            <p class="mt-4 max-w-sm leading-relaxed text-gray-400">
                Tu espacio para entrenar, mejorar tu bienestar y alcanzar
                resultados sostenibles.
            </p>

            <div class="mt-6 flex items-center gap-3">
                <a
                    href="#"
                    aria-label="Visitar Instagram de Weider Gym"
                    class="flex size-10 items-center justify-center rounded-full border border-zinc-700 transition duration-300 hover:border-red-600 hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-zinc-950"
                >
                    <img
                        src="/images/social/instagram-logo.svg"
                        alt=""
                        class="size-5"
                        aria-hidden="true"
                    />
                </a>

                <a
                    href="#inicio"
                    aria-label="Contactar a Weider Gym por WhatsApp"
                    class="flex size-10 items-center justify-center rounded-full border border-zinc-700 transition duration-300 hover:border-[#25D366] hover:bg-[#25D366] focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-zinc-950"
                >
                    <img
                        src="/images/social/whatsapp-logo.svg"
                        alt=""
                        class="size-5"
                        aria-hidden="true"
                    />
                </a>
            </div>
        </div>

        <!-- Navegación -->
        <nav aria-label="Navegación del pie de página">
            <h2
                class="border-l-4 border-zinc-600 pl-3 text-sm font-bold uppercase tracking-[0.2em] text-white"
            >
                Navegación
            </h2>

            <ul class="mt-5 space-y-3">
                {
                    footerLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-gray-400 transition hover:text-red-500 focus:outline-none focus:text-red-500"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <!-- Ubicación -->
        <div>
            <h2
                class="border-l-4 border-zinc-600 pl-3 text-sm font-bold uppercase tracking-[0.2em] text-white"
            >
                Ubicación
            </h2>

            <p class="mt-5 text-gray-400">Temuco, Chile</p>

            <a
                href="#contacto"
                class="mt-4 inline-block border-b border-red-600 pb-1 text-sm font-bold uppercase tracking-wide text-white transition hover:text-red-500"
            >
                Ver información de contacto
            </a>
        </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-zinc-800">
        <div class="mx-auto w-full max-w-7xl px-6 py-6 text-center">
            <p class="text-sm text-gray-400">
                © 2026 Weider Gym. Todos los derechos reservados.
            </p>
        </div>
    </div>
</footer>
