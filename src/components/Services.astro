---
const services = [
    {
        number: "01",
        title: "Entrenamiento personalizado",
        description:
            "Planificación individual, seguimiento constante y sesiones enfocadas en tus metas.",
    },
    {
        number: "02",
        title: "Clases grupales",
        description:
            "Entrena en grupos reducidos, con guía profesional y atención cercana.",
    },
    {
        number: "03",
        title: "Asesoría nutricional",
        description:
            "Orientación alimentaria para complementar tu entrenamiento y potenciar tus resultados.",
    },
];
---

<section id="servicios" class="bg-black py-20 text-white md:py-28">
    <div class="mx-auto w-full max-w-7xl px-6">
        <header class="max-w-3xl">
            <span
                class="border-l-4 border-red-600 pl-3 text-sm font-bold uppercase tracking-[0.2em] text-red-500"
            >
                Nuestros servicios</span
            >

            <h2
                class="mt-6 text-3xl font-black uppercase leading-tight tracking-tight sm:text-4xl md:text-5xl"
            >
                Entrenamiento diseñado para ti
            </h2>

            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-400">
                Elige una experiencia de entrenamiento adaptada a tus objetivos,
                tu nivel y tu ritmo.
            </p>
        </header>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
                services.map((service) => (
                    <article class="group relative overflow-hidden rounded-sm border border-zinc-800 bg-zinc-950 p-6 transition duration-300 hover:-translate-y-1 hover:border-red-600 hover:bg-zinc-900">
                        <span class="text-sm font-black uppercase tracking-[0.2em] text-red-500">
                            {service.number}
                        </span>

                        <div
                            class="mt-4 h-1 w-12 bg-red-600 transition-all duration-300 group-hover:w-20"
                            aria-hidden="true"
                        />

                        <h3 class="mt-6 text-2xl font-black uppercase text-white">
                            {service.title}
                        </h3>

                        <p class="mt-4 leading-relaxed text-gray-400">
                            {service.description}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
