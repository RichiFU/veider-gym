---
import BadgeCheck from "@lucide/astro/icons/badge-check";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Target from "@lucide/astro/icons/target";

const benefits = [
    {
        icon: BadgeCheck,
        title: "Calidad",
        description:
            "Entrenamientos planificados y atención enfocada en tu progreso.",
    },
    {
        icon: ShieldCheck,
        title: "Exclusividad",
        description:
            "Acceso limitado para mantener una experiencia cercana y personalizada.",
    },
    {
        icon: Target,
        title: "Resultados",
        description:
            "Objetivos claros, seguimiento constante y trabajo adaptado a ti.",
    },
];
---

<section id="nosotros" class="bg-zinc-950 py-20 text-white md:py-28">
    <div
        class="mx-auto grid w-full max-w-7xl gap-12 px-6 lg:grid-cols-2 lg:items-center"
    >
        <div class="reveal reveal-left">
            <span
                class="border-l-4 border-red-600 pl-3 text-sm font-bold uppercase tracking-[0.2em] text-red-500"
            >
                La experiencia Veider
            </span>

            <h2
                class="mt-6 text-4xl font-black uppercase leading-tight tracking-tight md:text-5xl"
            >
                Más que un gimnasio
            </h2>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-300">
                En Veider entrenas en un espacio exclusivo, con atención
                personalizada, clases grupales de alto nivel y objetivos
                diseñados para ti.
            </p>

            <p class="mt-4 max-w-xl text-lg leading-relaxed text-gray-400">
                Cada detalle está pensado para ofrecerte una experiencia de
                calidad, acompañamiento real y resultados visibles.
            </p>
        </div>

        <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-1">
            {
                benefits.map(({ icon: Icon, title, description }, index) => (
                    <article
                        class="h-full rounded-sm border border-zinc-800 bg-black/50 p-6 transition hover:border-red-600 hover:bg-black/70 reveal"
                        style={`--reveal-delay: ${index * 160}ms`}
                    >
                        <div class="flex items-center gap-3">
                            <Icon
                                class="size-8 shrink-0 text-red-500"
                                stroke-width={2.2}
                                aria-hidden="true"
                            />

                            <h3 class="text-xl font-black uppercase text-white">
                                {title}
                            </h3>
                        </div>

                        <p class="mt-4 leading-relaxed text-gray-400">
                            {description}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
