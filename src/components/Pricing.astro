---
import Check from "@lucide/astro/icons/check";

const plans = [
    {
        classes: "8 clases",
        price: "Consultar valor",
        recommended: false,
        features: [
            "Entrenamiento personalizado",
            "Seguimiento de tu progreso",
            "Horarios flexibles",
        ],
    },
    {
        classes: "12 clases",
        price: "Consultar valor",
        recommended: true,
        features: [
            "Entrenamiento personalizado",
            "Seguimiento de tu progreso",
            "Horarios flexibles",
        ],
    },
    {
        classes: "20 clases",
        price: "Consultar valor",
        recommended: false,
        features: [
            "Entrenamiento personalizado",
            "Seguimiento de tu progreso",
            "Horarios flexibles",
        ],
    },
];
---

<section id="planes" class="bg-zinc-950 py-20 text-white md:py-28">
    <div class="mx-auto w-full max-w-7xl px-6">
        <header class="mx-auto max-w-3xl text-center">
            <span
                class="inline-block border-b-2 border-red-600 pb-2 text-sm font-bold uppercase tracking-[0.2em] text-red-500"
                >Planes Veider</span
            >

            <h2
                class="mt-6 text-4xl font-black uppercase leading-tight tracking-tight md:text-5xl"
            >
                Elige el ritmo de tu transformación
            </h2>

            <p
                class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-400"
            >
                Encuentra un plan que se adapte a tu disponibilidad, objetivos y
                frecuencia de entrenamiento.
            </p>
        </header>

        <div
            class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:items-stretch"
        >
            {
                plans.map((plan) => (
                    <article
                        class:list={[
                            "relative flex h-full flex-col rounded-sm p-6 transition duration-300 hover:-translate-y-1",
                            plan.recommended
                                ? "border-2 border-red-600 bg-black/70 hover:shadow-lg hover:shadow-red-950/40"
                                : "border border-zinc-800 bg-black/40 hover:border-zinc-600 hover:bg-black/60",
                        ]}
                    >
                        {plan.recommended && (
                            <span class="absolute right-4 top-4 rounded-sm bg-red-600 px-3 py-1 text-xs font-black uppercase tracking-wide text-white">
                                Más elegido
                            </span>
                        )}
                        <header class={plan.recommended ? "pr-28" : ""}>
                            <p class="text-sm font-bold uppercase tracking-[0.2em] text-red-500">
                                Plan mensual
                            </p>

                            <h3 class="mt-3 text-4xl font-black uppercase text-white">
                                {plan.classes}
                            </h3>
                        </header>

                        <p class="mt-6 text-2xl font-black text-white">
                            {plan.price}
                        </p>

                        <ul class="mt-6 space-y-4 text-gray-300">
                            {plan.features.map((feature) => (
                                <li class="flex items-start gap-3">
                                    <Check
                                        class="mt-0.5 size-5 shrink-0 text-red-500"
                                        stroke-width={2.5}
                                        aria-hidden="true"
                                    />

                                    <span>{feature}</span>
                                </li>
                            ))}
                        </ul>

                        <a href="#contacto" class="mt-auto pt-8">
                            <span
                                class:list={[
                                    "block rounded-sm px-5 py-3 text-center text-sm font-bold uppercase tracking-wide text-white transition",
                                    plan.recommended
                                        ? "bg-red-600 hover:bg-red-700"
                                        : "border-2 border-red-600 hover:bg-red-600",
                                ]}
                            >
                                Consultar plan
                            </span>
                        </a>
                    </article>
                ))
            }
        </div>
    </div>
</section>
